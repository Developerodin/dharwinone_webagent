PORT=4000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_CREATIVE=gpt-4o
USE_FIXTURE_BRIEF=false
PIPELINE_STAGE_DELAY=0
PAGE_FAMILY=premium
FRONTEND_ORIGIN=http://localhost:5173

# Google Maps (also reads legacy googel_api). Enable Places API (New) + Maps JavaScript API.
# Billing must be on for Google map tiles. Search uses Places API (New), not legacy Places/Geocoding.
GOOGLE_MAPS_API_KEY=

# SMTP — restaurant-owner lead emails from contact/reservation forms.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TIMEOUT=7
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────
# Auth — see docs/AUTH-AND-ONBOARDING-PLAN.md
# ─────────────────────────────────────────────────────────────

# Local Postgres. Same URL for both — no pooler in dest.
# Prod (Neon): DATABASE_URL = pooled, DIRECT_DATABASE_URL = unpooled + sslmode=require.
DATABASE_URL=postgresql://USER@localhost:5432/prowplus
DIRECT_DATABASE_URL=postgresql://USER@localhost:5432/prowplus

# Signing secrets. MUST be different from each other and 32+ chars.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_RESET_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Used in email links. Must match the deployed frontend origin.
APP_URL=http://localhost:5173
# Blank in dev. In production set to the shared parent domain, e.g. ".prowplus.com"
COOKIE_DOMAIN=

# Google Identity Services. Same value goes in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Only needed for the redirect/auth-code fallback flow.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# One-time codes
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_PER_HOUR=5

# Brute-force protection
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# Set to require an invite code at signup. Leave blank for open signup.
SIGNUP_INVITE_CODE=

# ─────────────────────────────────────────────────────────────
# Object storage (S3 or Cloudflare R2). All four of bucket / keys / CDN
# must be set or upload routes return STORAGE_UNAVAILABLE and the rest
# of the API still boots.
# Leave STORAGE_ENDPOINT blank for AWS S3. Required for R2 / MinIO.
# ─────────────────────────────────────────────────────────────
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base for stored objects. Uploads stay disabled until this is set,
# because a presigned upload has no usable URL to hand back without it.
#   AWS S3: https://<bucket>.s3.<region>.amazonaws.com
# Serve it from a different origin than the app, so a malicious upload cannot
# execute in the app's origin.
CDN_BASE_URL=
PRESIGN_TTL_SECONDS=300

# Quotas
MAX_PAGE_BYTES=1048576
MAX_PROJECTS_PER_USER=50
MAX_VERSIONS_PER_PROJECT=500
MAX_STORAGE_BYTES_PER_USER=2147483648
MAX_IMAGE_BYTES=26214400
MAX_VIDEO_BYTES=52428800
MAX_MESSAGES_PER_PROJECT=2000

# Retention
TRASH_RETENTION_DAYS=30
VERSION_RETENTION_DAYS=30

# Pagination
DEFAULT_PAGE_SIZE=24
MAX_PAGE_SIZE=100
